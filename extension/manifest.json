{
  "manifest_version": 3,
  "name": "Achados da Nanda PRO",
  "version": "1.1.0",
  "description": "Capture ofertas com 1 clique da Shopee, Mercado Livre, Amazon e clone ofertas no WhatsApp Web com seu link de afiliada.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://*.mercadolivre.com.br/*",
    "https://*.mercadolibre.com/*",
    "https://*.shopee.com.br/*",
    "https://*.amazon.com.br/*",
    "https://web.whatsapp.com/*",
    "https://*.tiktok.com/*",
    "http://localhost:3000/*",
    "https://*.vercel.app/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.mercadolivre.com.br/*",
        "https://*.mercadolibre.com/*"
      ],
      "js": ["content/ml-scraper.js", "content/harvester-overlay.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.shopee.com.br/*"
      ],
      "js": ["content/shopee-scraper.js", "content/harvester-overlay.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.amazon.com.br/*"
      ],
      "js": ["content/amazon-scraper.js", "content/harvester-overlay.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": ["content/whatsapp-scraper.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.tiktok.com/*"
      ],
      "js": ["content/tiktok-automator.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
