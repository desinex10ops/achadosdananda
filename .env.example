# ==========================================
# BANCO DE DADOS (SUPABASE / POSTGRESQL)
# ==========================================
# No painel do Supabase: Project Settings -> Database -> Connection string -> URI
# Modo Transaction (Pooler / porta 6543) - Para a aplicação Vercel
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Modo Session (Direct / porta 5432) - Para migrações e comandos prisma
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ==========================================
# SESSÃO E SEGURANÇA
# ==========================================
NEXTAUTH_SECRET="gere-um-segredo-com-openssl-rand-hex-32"
NEXTAUTH_URL="https://achadosdananda.vercel.app" # Em dev: http://localhost:3000
APP_ENV="production"

# ==========================================
# USUÁRIO ADMINISTRADOR PADRÃO
# ==========================================
ADMIN_NAME="Fernanda (Nanda)"
ADMIN_EMAIL="nanda@achadosdananda.com.br"
ADMIN_PASSWORD="sua-senha-segura-aqui"

# ==========================================
# AFILIADOS E MARKETPLACES (OPCIONAL)
# ==========================================
