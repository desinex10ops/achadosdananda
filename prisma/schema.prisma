datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  avatarUrl    String?
  role         String    @default("ADMIN")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  settings     Settings?
}

model Settings {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultIntervalMinutes Int      @default(30)
  maxOffersPerHour       Int      @default(4)
  maxDailyOffers         Int      @default(20)
  antiRepeatHours        Int      @default(48)
  autoQueueEnabled       Boolean  @default(false)
  defaultTemplateId      String?
  metaPixelId            String?
  updatedAt              DateTime @updatedAt
}

model Marketplace {
  id                String          @id @default(cuid())
  name              String          @unique
  slug              String          @unique
  icon              String?
  badgeColor        String          @default("gray")
  isActive          Boolean         @default(true)
  commissionRate    Float           @default(0.0)
  affiliateTag      String?
  appId             String?
  apiKey            String?
  apiSecret         String?
  defaultUrlPattern String?
  products          Product[]
  offers            Offer[]
  coupons           Coupon[]
  affiliateLinks    AffiliateLink[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model Product {
  id               String          @id @default(cuid())
  marketplaceId    String
  marketplace      Marketplace     @relation(fields: [marketplaceId], references: [id])
  name             String
  description      String?
  category         String          @default("Geral")
  subcategory      String?
  brand            String?
  originalPrice    Float
  currentPrice     Float
  imageUrl         String
  additionalImages String? // JSON string array
  originalUrl      String
  affiliateUrl     String?
  stock            Int?
  expirationDate   DateTime?
  notes            String?
  offers           Offer[]
  affiliateLinks   AffiliateLink[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model Offer {
  id                 String         @id @default(cuid())
  productId          String
  product            Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  marketplaceId      String
  marketplace        Marketplace    @relation(fields: [marketplaceId], references: [id])
  title              String
  callout            String?
  originalPrice      Float
  currentPrice       Float
  discountPercentage Float
  savedAmount        Float
  couponCode         String?
  shippingInfo       String?        @default("Frete Grátis")
  originalUrl        String
  affiliateUrl       String
  status             String         @default("QUEUED") // DRAFT, RADAR, QUEUED, SCHEDULED, PUBLISHED, IGNORED, PAUSED
  notes              String?
  priority           Int            @default(1)
  publications       Publication[]
  clicks             Click[]
  conversions        Conversion[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model Template {
  id                String        @id @default(cuid())
  name              String
  type              String        @default("CUSTOM") // OFERTA_RELAMPAGO, OFERTA_DO_DIA, ACHADINHO, CUPOM, SUPER_DESCONTO, OFERTA_TECH, OFERTA_CASA, OFERTA_GERAL, CUSTOM
  emoji             String        @default("🔥")
  header            String
  structure         String // Template pattern with placeholders {TITULO}, {PRECO_DE}, {PRECO_POR}, etc.
  cta               String        @default("👇 COMPRE PELO LINK ABAIXO:")
  footer            String?
  showOriginalPrice Boolean       @default(true)
  showDiscount      Boolean       @default(true)
  showCoupon        Boolean       @default(true)
  showShipping      Boolean       @default(true)
  isDefault         Boolean       @default(false)
  publications      Publication[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model GroupCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  groups      Group[]
  createdAt   DateTime @default(now())
}

model Group {
  id                 String             @id @default(cuid())
  name               String
  categoryId         String
  category           GroupCategory      @relation(fields: [categoryId], references: [id])
  description        String?
  platform           String             @default("WHATSAPP") // WHATSAPP, TELEGRAM, EVOLUTION
  whatsappJid        String?            // ex: 120363028394839@g.us (JID do grupo)
  instanceName       String?            // ex: nanda-moda, nanda-casa (Instância Evolution)
  allowedHoursStart  String             @default("08:00")
  allowedHoursEnd    String             @default("22:00")
  maxOffersPerHour   Int                @default(2)
  maxDailyOffers     Int                @default(15)
  minIntervalMinutes Int                @default(30)
  isActive           Boolean            @default(true)
  inviteLink         String?
  isVipRouter        Boolean            @default(false)
  maxMembers         Int                @default(1000)
  currentClicks      Int                @default(0)
  priority           Int                @default(1)
  publicationGroups  PublicationGroup[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model WhatsAppInstance {
  id             String    @id @default(cuid())
  name           String    @unique // ex: nanda-moda, nanda-casa, nanda-tech
  label          String?   // ex: "Chip Moda & Beleza #1"
  nicheSlug      String?   // moda, casa, tech, etc.
  phone          String?   // ex: 5511999998888
  status         String    @default("DISCONNECTED") // CONNECTED, CONNECTING, DISCONNECTED
  qrCode         String?
  lastSeenAt     DateTime?
  dailySentCount Int       @default(0)
  maxDailySends  Int       @default(250)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model OfferPublishHistory {
  id          String   @id @default(cuid())
  offerId     String
  groupId     String
  productHash String   // canonical SKU/ID para anti-repetição de 7 dias
  publishedAt DateTime @default(now())
  priceAtSend Float

  @@index([groupId, productHash])
  @@index([publishedAt])
}

model Lead {
  id          String   @id @default(cuid())
  name        String?
  phone       String?
  source      String   @default("VIP_PAGE")
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
}

model Publication {
  id                String             @id @default(cuid())
  offerId           String
  offer             Offer              @relation(fields: [offerId], references: [id], onDelete: Cascade)
  templateId        String
  template          Template           @relation(fields: [templateId], references: [id])
  scheduledFor      DateTime?
  publishedAt       DateTime?
  status            String             @default("PENDING") // PENDING, SCHEDULED, PUBLISHED, ERROR, PAUSED
  priority          Int                @default(1)
  orderIndex        Int                @default(0)
  errorMessage      String?
  generatedText     String
  publicationGroups PublicationGroup[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model PublicationGroup {
  id            String      @id @default(cuid())
  publicationId String
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  groupId       String
  group         Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  status        String      @default("PENDING") // PENDING, PUBLISHED, ERROR
  publishedAt   DateTime?
  errorMessage  String?
  createdAt     DateTime    @default(now())
}

model Coupon {
  id            String      @id @default(cuid())
  marketplaceId String
  marketplace   Marketplace @relation(fields: [marketplaceId], references: [id])
  code          String
  discount      String // e.g. "R$ 20 OFF" or "15% OFF"
  minSpend      Float?
  validUntil    DateTime?
  category      String?
  link          String?
  status        String      @default("ACTIVE") // ACTIVE, EXPIRED, EXPIRING_SOON
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model AffiliateLink {
  id               String       @id @default(cuid())
  productId        String?
  product          Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  marketplaceId    String
  marketplace      Marketplace  @relation(fields: [marketplaceId], references: [id])
  originalUrl      String
  affiliateUrl     String
  campaign         String?
  clicksCount      Int          @default(0)
  conversionsCount Int          @default(0)
  clicks           Click[]
  conversions      Conversion[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Click {
  id        String         @id @default(cuid())
  linkId    String?
  link      AffiliateLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)
  offerId   String?
  offer     Offer?         @relation(fields: [offerId], references: [id], onDelete: SetNull)
  ipAddress String?
  userAgent String?
  referrer  String?
  createdAt DateTime       @default(now())
}

model Conversion {
  id              String         @id @default(cuid())
  linkId          String?
  link            AffiliateLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)
  offerId         String?
  offer           Offer?         @relation(fields: [offerId], references: [id], onDelete: SetNull)
  orderId         String?
  orderValue      Float
  commissionValue Float
  status          String         @default("PENDING") // PENDING, APPROVED, CANCELLED, PAID
  convertedAt     DateTime       @default(now())
  createdAt       DateTime       @default(now())
}

model AutomationRule {
  id                String   @id @default(cuid())
  name              String
  isActive          Boolean  @default(true)
  conditionField    String // e.g. "discountPercentage", "category", "hasCoupon"
  conditionOperator String // e.g. ">=", "==", "contains"
  conditionValue    String // e.g. "30", "Tecnologia", "true"
  actionType        String // e.g. "ADD_TO_QUEUE", "SET_PRIORITY", "APPLY_TEMPLATE"
  actionPayload     String // JSON details
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("INFO") // INFO, SUCCESS, WARNING, ERROR
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  module    String
  details   String?
  status    String   @default("SUCCESS") // SUCCESS, ERROR, WARN
  createdAt DateTime @default(now())
}

model GroupMirrorRule {
  id                 String   @id @default(cuid())
  sourceGroupName    String
  sourceGroupId      String?
  targetGroupId      String?
  targetGroupName    String
  style              String   @default("CLONE")
  mediaFormat        String   @default("IMAGE")
  intervalMinutes    Int      @default(0)
  filterOfficialOnly Boolean  @default(true)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

