datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  avatarUrl    String?
  role         String    @default("ADMIN")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  settings     Settings?
}

model Settings {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultIntervalMinutes Int      @default(30)
  maxOffersPerHour       Int      @default(4)
  maxDailyOffers         Int      @default(20)
  antiRepeatHours        Int      @default(48)
  autoQueueEnabled       Boolean  @default(false)
  defaultTemplateId      String?
  updatedAt              DateTime @updatedAt
}

model Marketplace {
  id                String          @id @default(cuid())
  name              String          @unique
  slug              String          @unique
  icon              String?
  badgeColor        String          @default("gray")
  isActive          Boolean         @default(true)
  commissionRate    Float           @default(0.0)
  affiliateTag      String?
  appId             String?
  apiKey            String?
  apiSecret         String?
  defaultUrlPattern String?
  products          Product[]
  offers            Offer[]
  coupons           Coupon[]
  affiliateLinks    AffiliateLink[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model Product {
  id               String          @id @default(cuid())
  marketplaceId    String
  marketplace      Marketplace     @relation(fields: [marketplaceId], references: [id])
  name             String
  description      String?
  category         String          @default("Geral")
  subcategory      String?
  brand            String?
  originalPrice    Float
  currentPrice     Float
  imageUrl         String
  additionalImages String?
  originalUrl      String
  affiliateUrl     String?
  stock            Int?
  expirationDate   DateTime?
  notes            String?
  offers           Offer[]
  affiliateLinks   AffiliateLink[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model Offer {
  id                 String         @id @default(cuid())
  productId          String
  product            Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  marketplaceId      String
  marketplace        Marketplace    @relation(fields: [marketplaceId], references: [id])
  title              String
  callout            String?
  originalPrice      Float
  currentPrice       Float
  discountPercentage Float
  savedAmount        Float
  couponCode         String?
  shippingInfo       String?        @default("Frete Grátis")
  originalUrl        String
  affiliateUrl       String
  status             String         @default("QUEUED")
  notes              String?
  priority           Int            @default(1)
  publications       Publication[]
  clicks             Click[]
  conversions        Conversion[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model Template {
  id                String        @id @default(cuid())
  name              String
  type              String        @default("CUSTOM")
  emoji             String        @default("🔥")
  header            String
  structure         String
  cta               String        @default("👇 COMPRE PELO LINK ABAIXO:")
  footer            String?
  showOriginalPrice Boolean       @default(true)
  showDiscount      Boolean       @default(true)
  showCoupon        Boolean       @default(true)
  showShipping      Boolean       @default(true)
  isDefault         Boolean       @default(false)
  publications      Publication[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model GroupCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  groups      Group[]
  createdAt   DateTime @default(now())
}

model Group {
  id                 String             @id @default(cuid())
  name               String
  categoryId         String
  category           GroupCategory      @relation(fields: [categoryId], references: [id])
  description        String?
  platform           String             @default("WHATSAPP")
  allowedHoursStart  String             @default("08:00")
  allowedHoursEnd    String             @default("22:00")
  maxOffersPerHour   Int                @default(2)
  maxDailyOffers     Int                @default(15)
  minIntervalMinutes Int                @default(30)
  isActive           Boolean            @default(true)
  publicationGroups  PublicationGroup[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model Publication {
  id                String             @id @default(cuid())
  offerId           String
  offer             Offer              @relation(fields: [offerId], references: [id], onDelete: Cascade)
  templateId        String
  template          Template           @relation(fields: [templateId], references: [id])
  scheduledFor      DateTime?
  publishedAt       DateTime?
  status            String             @default("PENDING")
  priority          Int                @default(1)
  orderIndex        Int                @default(0)
  errorMessage      String?
  generatedText     String
  publicationGroups PublicationGroup[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model PublicationGroup {
  id            String      @id @default(cuid())
  publicationId String
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  groupId       String
  group         Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  status        String      @default("PENDING")
  publishedAt   DateTime?
  errorMessage  String?
  createdAt     DateTime    @default(now())
}

model Coupon {
  id            String      @id @default(cuid())
  marketplaceId String
  marketplace   Marketplace @relation(fields: [marketplaceId], references: [id])
  code          String
  discount      String
  minSpend      Float?
  validUntil    DateTime?
  category      String?
  link          String?
  status        String      @default("ACTIVE")
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model AffiliateLink {
  id               String       @id @default(cuid())
  productId        String?
  product          Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  marketplaceId    String
  marketplace      Marketplace  @relation(fields: [marketplaceId], references: [id])
  originalUrl      String
  affiliateUrl     String
  campaign         String?
  clicksCount      Int          @default(0)
  conversionsCount Int          @default(0)
  clicks           Click[]
  conversions      Conversion[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model Click {
  id        String         @id @default(cuid())
  linkId    String?
  link      AffiliateLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)
  offerId   String?
  offer     Offer?         @relation(fields: [offerId], references: [id], onDelete: SetNull)
  ipAddress String?
  userAgent String?
  referrer  String?
  createdAt DateTime       @default(now())
}

model Conversion {
  id              String         @id @default(cuid())
  linkId          String?
  link            AffiliateLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)
  offerId         String?
  offer           Offer?         @relation(fields: [offerId], references: [id], onDelete: SetNull)
  orderId         String?
  orderValue      Float
  commissionValue Float
  status          String         @default("PENDING")
  convertedAt     DateTime       @default(now())
  createdAt       DateTime       @default(now())
}

model AutomationRule {
  id                String   @id @default(cuid())
  name              String
  isActive          Boolean  @default(true)
  conditionField    String
  conditionOperator String
  conditionValue    String
  actionType        String
  actionPayload     String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  module    String
  details   String?
  status    String   @default("SUCCESS")
  createdAt DateTime @default(now())
}
